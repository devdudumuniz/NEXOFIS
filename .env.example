# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Banco de dados (sqlite por padrão; defina postgres + DATABASE_URL para produção)
NEXOFIS_DB_DRIVER=sqlite
DATABASE_URL=
POSTGRES_USER=nexofis
POSTGRES_PASSWORD=
POSTGRES_DB=nexofis

# Serviços externos opcionais de OCR (Docling Serve + Worker PaddleOCR)
DOCLING_SERVE_URL=
PADDLE_OCR_URL=

# Autenticação Bearer HMAC e RBAC (opt-in; mantenha false para uso local sem login)
NEXOFIS_AUTH_ENABLED=false
NEXOFIS_SESSION_SECRET=

# Chave oficial da API do Portal da Transparência (CGU — CEIS, CNEP, CEPIM)
PORTAL_TRANSPARENCIA_API_KEY=

