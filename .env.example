# ============================================================================
# NEXOFIS — Variáveis de Ambiente (Template sem segredos)
# ============================================================================

# Chave Gemini (opcional — usada apenas como fallback multimodal em PDFs escaneados)
GEMINI_API_KEY=

# URL pública da aplicação (opcional)
APP_URL=http://localhost:3000

# Persistência SQLite (padrão) ou PostgreSQL
NEXOFIS_DB_DRIVER=sqlite
NEXOFIS_SQLITE_PATH=data/nexofis.db
NEXOFIS_JOBS_DB_PATH=data/nexofis-jobs.db
DATABASE_URL=
POSTGRES_USER=nexofis
POSTGRES_PASSWORD=
POSTGRES_DB=nexofis

# Serviços externos opcionais de OCR (perfil Docker: --profile full-ocr)
# Ex.: http://docling-serve:5001 e http://paddleocr-worker:8090
DOCLING_SERVE_URL=
PADDLE_OCR_URL=

# Autenticação Bearer HMAC e RBAC
# Em NODE_ENV=production a autenticação é obrigatória (fail-closed) e exige
# NEXOFIS_SESSION_SECRET com pelo menos 32 caracteres aleatórios.
# Para desenvolvimento local sem login, mantenha NODE_ENV=development ou defina
# NEXOFIS_ALLOW_INSECURE_LOCAL=true apenas em rede isolada.
NEXOFIS_AUTH_ENABLED=false
NEXOFIS_ALLOW_INSECURE_LOCAL=false
NEXOFIS_SESSION_SECRET=

# Chave oficial da API do Portal da Transparência (CGU — CEIS, CNEP, CEPIM)
PORTAL_TRANSPARENCIA_API_KEY=
